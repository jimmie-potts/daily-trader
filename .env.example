# Runtime identity. Defaults remain local, paper-only, and execution-disabled.
APP_ENV=local
BROKER_MODE=paper
EXECUTION_ENABLED=false

# Local process behavior. Telemetry is disabled or console-only.
LOG_LEVEL=info
TELEMETRY_EXPORTER=none
API_HOST=127.0.0.1
API_PORT=3001
WORKER_HEARTBEAT_INTERVAL_MS=30000

# Phase 2 market data is disabled by default. Enabling paper mode requires the
# credential pair below and permits only Alpaca IEX one-minute bars for AAPL/SPY.
# Fixture and replay validation remain credential-free and do not open this endpoint.
MARKET_DATA_MODE=disabled
MARKET_DATA_PROVIDER=alpaca
MARKET_DATA_FEED=iex
MARKET_DATA_WS_URL=wss://stream.data.alpaca.markets/v2/iex
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_SYMBOLS=AAPL,SPY

# Market-data lifecycle bounds: connection 100-60000 ms; inactivity
# 1000-300000 ms and greater than connection; freshness 60000-300000 ms;
# shutdown 100-30000 ms; queue capacity 1-10000 entries.
MARKET_DATA_CONNECTION_TIMEOUT_MS=10000
MARKET_DATA_INACTIVITY_TIMEOUT_MS=90000
MARKET_DATA_FRESHNESS_THRESHOLD_MS=120000
MARKET_DATA_SHUTDOWN_TIMEOUT_MS=10000
MARKET_DATA_QUEUE_CAPACITY=256

# Reconnect bounds: attempts 1-20; base delay 100-30000 ms; max delay
# 100-120000 ms and at least base; jitter 0-50%. Max delay including jitter
# cannot exceed the inactivity timeout.
MARKET_DATA_RECONNECT_MAX_ATTEMPTS=5
MARKET_DATA_RECONNECT_BASE_DELAY_MS=500
MARKET_DATA_RECONNECT_MAX_DELAY_MS=30000
MARKET_DATA_RECONNECT_JITTER_PERCENT=20

# Phase 3 deterministic signal monitoring is disabled by default. The only
# accepted monitor observes AAPL/XNAS and SPY/ARCX one-minute canonical bars.
SIGNAL_MODE=disabled
SIGNAL_CONFIGURATION_VERSION=phase3-v1
SIGNAL_DEFINITION=breakout_plus_volume.v1
SIGNAL_SYMBOLS=AAPL,SPY
SIGNAL_LOOKBACK_WINDOW=20
SIGNAL_VOLUME_MULTIPLIER=1.5

# Durable journal worker bounds. Capacity failure stops safely; it never drops
# a canonical revision or changes an evaluation outcome.
SIGNAL_JOURNAL_POLL_INTERVAL_MS=250
SIGNAL_CLAIM_BATCH_SIZE=50
SIGNAL_QUEUE_CAPACITY=1000
SIGNAL_RETRY_MAX_ATTEMPTS=5
SIGNAL_RETRY_BASE_DELAY_MS=100
SIGNAL_RETRY_MAX_DELAY_MS=5000
SIGNAL_RETRY_JITTER_PERCENT=20
SIGNAL_BACKLOG_LIMIT=10000
SIGNAL_STATEMENT_TIMEOUT_MS=10000
SIGNAL_CLAIM_LEASE_MS=30000
SIGNAL_CLAIM_RENEW_INTERVAL_MS=10000
SIGNAL_SHUTDOWN_TIMEOUT_MS=10000

# Phase 4 paper-account monitoring is disabled by default. paper_read_only
# permits only bounded GET requests to the exact Alpaca paper Trading API.
# It requires a dedicated credential pair and the expected raw account ID;
# identifiers are fingerprinted before they reach application contracts.
# Collection item limits stay below pages multiplied by page size so a short
# terminal page can prove completeness within the bounded request budget.
PORTFOLIO_MODE=disabled
PORTFOLIO_SYNC_INTERVAL_MS=30000
PORTFOLIO_REQUEST_TIMEOUT_MS=10000
PORTFOLIO_STALE_AFTER_MS=90000
PORTFOLIO_MAX_RESPONSE_BYTES=4194304
PORTFOLIO_MAX_PAGES=20
PORTFOLIO_ORDER_PAGE_SIZE=500
PORTFOLIO_FILL_PAGE_SIZE=100
PORTFOLIO_MAX_POSITIONS=1000
PORTFOLIO_MAX_ORDERS=5000
PORTFOLIO_MAX_FILLS_PER_SYNC=1999
PORTFOLIO_RETRY_MAX_ATTEMPTS=3
PORTFOLIO_RETRY_BASE_DELAY_MS=250
PORTFOLIO_RETRY_MAX_DELAY_MS=5000
PORTFOLIO_RETRY_JITTER_PERCENT=20
PORTFOLIO_STATEMENT_TIMEOUT_MS=10000
PORTFOLIO_CLAIM_LEASE_MS=60000
PORTFOLIO_CLAIM_RENEW_INTERVAL_MS=20000
PORTFOLIO_SHUTDOWN_TIMEOUT_MS=10000

# Optional local PostgreSQL/TimescaleDB override. Blank uses the safe Compose default.
DATABASE_URL=
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Optional local Redis override. Blank uses the loopback-only Compose default.
REDIS_URL=
REDIS_CONNECTION_TIMEOUT_MS=5000

# Separate paper brokerage settings for Phase 4. Blank values are safe in
# disabled mode. The base URL defaults to the pinned paper endpoint.
PAPER_BROKER_BASE_URL=
PAPER_BROKER_API_KEY=
PAPER_BROKER_API_SECRET=
PAPER_BROKER_ACCOUNT_ID=

# Reserved future live-provider settings. The current paper-only phase rejects any non-empty value.
LIVE_BROKER_BASE_URL=
LIVE_BROKER_API_KEY=
LIVE_BROKER_API_SECRET=
LIVE_BROKER_ACCOUNT_ID=
