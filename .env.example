# Runtime identity. Phase 1 defaults are local, paper-only, and execution-disabled.
APP_ENV=local
BROKER_MODE=paper
EXECUTION_ENABLED=false

# Local process behavior. Phase 1 telemetry is disabled or console-only.
LOG_LEVEL=info
TELEMETRY_EXPORTER=none
API_HOST=127.0.0.1
API_PORT=3001
WORKER_HEARTBEAT_INTERVAL_MS=30000

# Optional local PostgreSQL/TimescaleDB override. Blank uses the safe Compose default.
DATABASE_URL=
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Optional local Redis override. Blank uses the loopback-only Compose default.
REDIS_URL=
REDIS_CONNECTION_TIMEOUT_MS=5000

# Optional paper-provider settings. Leave blank until a paper adapter owns them.
PAPER_BROKER_BASE_URL=
PAPER_BROKER_API_KEY=
PAPER_BROKER_API_SECRET=
PAPER_BROKER_ACCOUNT_ID=

# Reserved future live-provider settings. Phase 1 rejects any non-empty value.
LIVE_BROKER_BASE_URL=
LIVE_BROKER_API_KEY=
LIVE_BROKER_API_SECRET=
LIVE_BROKER_ACCOUNT_ID=
