# Runtime identity. Defaults remain local, paper-only, and execution-disabled.
APP_ENV=local
BROKER_MODE=paper
EXECUTION_ENABLED=false

# Local process behavior. Telemetry is disabled or console-only.
LOG_LEVEL=info
TELEMETRY_EXPORTER=none
API_HOST=127.0.0.1
API_PORT=3001
WORKER_HEARTBEAT_INTERVAL_MS=30000

# Phase 2 market data is disabled by default. Enabling paper mode requires the
# credential pair below and permits only Alpaca IEX one-minute bars for AAPL/SPY.
# Fixture and replay validation remain credential-free and do not open this endpoint.
MARKET_DATA_MODE=disabled
MARKET_DATA_PROVIDER=alpaca
MARKET_DATA_FEED=iex
MARKET_DATA_WS_URL=wss://stream.data.alpaca.markets/v2/iex
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_SYMBOLS=AAPL,SPY

# Market-data lifecycle bounds: connection 100-60000 ms; inactivity
# 1000-300000 ms and greater than connection; freshness 60000-300000 ms;
# shutdown 100-30000 ms; queue capacity 1-10000 entries.
MARKET_DATA_CONNECTION_TIMEOUT_MS=10000
MARKET_DATA_INACTIVITY_TIMEOUT_MS=90000
MARKET_DATA_FRESHNESS_THRESHOLD_MS=120000
MARKET_DATA_SHUTDOWN_TIMEOUT_MS=10000
MARKET_DATA_QUEUE_CAPACITY=256

# Reconnect bounds: attempts 1-20; base delay 100-30000 ms; max delay
# 100-120000 ms and at least base; jitter 0-50%. Max delay including jitter
# cannot exceed the inactivity timeout.
MARKET_DATA_RECONNECT_MAX_ATTEMPTS=5
MARKET_DATA_RECONNECT_BASE_DELAY_MS=500
MARKET_DATA_RECONNECT_MAX_DELAY_MS=30000
MARKET_DATA_RECONNECT_JITTER_PERCENT=20

# Optional local PostgreSQL/TimescaleDB override. Blank uses the safe Compose default.
DATABASE_URL=
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Optional local Redis override. Blank uses the loopback-only Compose default.
REDIS_URL=
REDIS_CONNECTION_TIMEOUT_MS=5000

# Optional paper-provider settings. Leave blank until a paper adapter owns them.
PAPER_BROKER_BASE_URL=
PAPER_BROKER_API_KEY=
PAPER_BROKER_API_SECRET=
PAPER_BROKER_ACCOUNT_ID=

# Reserved future live-provider settings. The current paper-only phase rejects any non-empty value.
LIVE_BROKER_BASE_URL=
LIVE_BROKER_API_KEY=
LIVE_BROKER_API_SECRET=
LIVE_BROKER_ACCOUNT_ID=
