{
  "name": "@daily-trader/portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@daily-trader/domain": "*",
    "big.js": "7.0.1"
  },
  "devDependencies": {
    "@types/big.js": "6.2.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build --workspace=@daily-trader/domain --prefix ../..",
    "pretest:watch": "npm run build --workspace=@daily-trader/domain --prefix ../..",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/portfolio",
    "test:watch": "vitest --root ../.. packages/portfolio"
  }
}
