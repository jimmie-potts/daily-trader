{
  "name": "@daily-trader/market-data-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "pretest": "npm run build:packages --prefix ../..",
    "pretest:watch": "npm run build:packages --prefix ../..",
    "smoke": "npm run build && node dist/index.js --once",
    "start": "node dist/index.js",
    "test": "vitest run --root ../.. workers/market-data",
    "test:watch": "vitest --root ../.. workers/market-data",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@daily-trader/config": "*",
    "@daily-trader/domain": "*",
    "@daily-trader/market-data": "*",
    "@daily-trader/observability": "*",
    "pg": "8.22.0",
    "redis": "6.1.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
